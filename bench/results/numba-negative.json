  "verdicts": {
    "cause": {
      "status": "MEASURED",
      "finding": "GNU OpenMP (Numba's omp threading layer) busy-waits its idle workers. On a VM whose run queue is 9x to 20x its 8 CPUs, every one of the 291 parallel region calls per study waits for 8 spinning workers to be scheduled. The same 8 threads with OMP_WAIT_POLICY=PASSIVE, or with Numba's workqueue layer, are faster than NumPy.",
      "evidence": [
        "Empty prange launch: 3.4 to 3.8 us at 1 thread, 6.2 us at 2, 47,000 to 52,000 us at 8 with the omp layer's default active wait; 4,482 us with workqueue; 193 and 855 us with OMP_WAIT_POLICY=PASSIVE",
        "Numba process CPU per study: 1.4 s at 1 thread; 24.5 to 27.3 s at 8 threads with active wait; 1.4 to 1.7 s at 8 threads with passive wait or workqueue, for identical outputs (parity asserted every study)",
        "Numba over NumPy per study, paired: 0.25 and 0.61 at 1 thread; 0.79 at 2; 2.06 to 2.87 at 8 with active wait (three runs); 0.45 at 8 with workqueue; 0.28 and 0.42 at 8 with passive wait",
        "Count kernel alone: 4.0 to 6.0 ms per region call at 1 thread; 81 to 152 ms at 8 with active wait; 8.8 ms with workqueue; 3.2 to 3.6 ms with passive wait"
      ]
    },
    "candidates": {
      "jit_compile_in_timing": {
        "status": "MEASURED",
        "verdict": "ruled out",
        "evidence": "cpu-ladder.json already excludes the first call (first_call_excluded_from_rows: true); here the first call is timed separately and seed 0 is a warm-up; cache=True kernels load from cache"
      },
      "thread_oversubscription_numba_x_blas": {
        "status": "MEASURED",
        "verdict": "ruled out",
        "evidence": "8 threads with OMP/OPENBLAS/MKL threads unset: 50.5 s per study vs 56.7 s pinned to 1, same within load noise; the timed path has no BLAS call"
      },
      "vm_load_average": {
        "status": "MEASURED",
        "verdict": "necessary condition, not the fix",
        "evidence": "Load average 48 to 150 throughout. Under the same load, passive wait turns the 8-thread loss (2.1x to 2.9x slower than NumPy) into a 2.4x to 3.5x win. Oversubscription by other processes is what makes active spinning expensive"
      },
      "work_too_small_per_thread": {
        "status": "MEASURED",
        "verdict": "contributes, secondary",
        "evidence": "Median region 2,192 cells, 55% visible after the 400 um crop: about 150 visible cells per thread per call, 6 ms of single-thread work. Even with workqueue, 8 threads (6.8 s) did not beat 1 thread (5.3 s) under this load"
      },
      "memory_bandwidth": {
        "status": "MEASURED",
        "verdict": "ruled out",
        "evidence": "Same kernel, same 8 threads, same memory traffic: 81 to 152 ms per call with active wait against 3.2 to 3.6 ms with passive wait. An empty kernel with no memory traffic reproduces the 47 to 52 ms launch cost"
      },
      "race_safe_reduction": {
        "status": "MEASURED",
        "verdict": "ruled out by the code",
        "evidence": "reimage/cpu.py _counts writes only out[i] inside prange(i): no reduction variable, no atomics, no shared accumulator"
      }
    },
    "side_effect": {
      "status": "ESTIMATE",
      "finding": "Not established. NumPy beside active-wait Numba took 18.2 s and 9.7 s per study in two runs; beside passive-wait Numba, 8.7 s and 12.0 s. Load moved too much between runs to separate the effects."
    },
    "fixes": [
      {
        "status": "MEASURED",
        "fix": "Set OMP_WAIT_POLICY=PASSIVE (or NUMBA_THREADING_LAYER=workqueue) for every Numba run on a shared machine",
        "effect": "8-thread Numba 2.48 s vs NumPy 8.72 s, and 5.02 s vs 11.96 s, per study under load 50 to 60"
      },
      {
        "status": "MEASURED",
        "fix": "Or run Numba single-threaded per study and parallelise across studies (one worker per core)",
        "effect": "1-thread Numba 5.35 s vs NumPy 21.7 s, and 4.45 s vs 7.29 s, per study under load 50 to 150"
      },
      {
        "status": "ESTIMATE",
        "fix": "Batch all 291 regions of a study into one prange call so each study pays one fork-join instead of 291",
        "effect": "not built or measured"
      },
      {
        "status": "ESTIMATE",
        "fix": "Re-run bench/real_cpu.py with the fix on a quiet host (load average below 8) before quoting a speed-up",
        "effect": "the cpu-ladder.json 8-thread rows (3.26 s vs 2.98 s) were taken at load 10 to 26 with active wait; they are not a property of the kernel"
      }
    ]
  }
}
